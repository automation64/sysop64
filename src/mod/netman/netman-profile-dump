declare S64_CORE_PATH_ROOT="${S64_CORE_PATH_ROOT:-/opt/sysop64}"
[[ ! -d "$S64_CORE_PATH_ROOT" ]] && S64_CORE_PATH_ROOT="${HOME}/at64/sysop64"
source "${S64_CORE_PATH_ROOT}/lib/core.lib" && source "${S64_CORE_PATH_LIB}/netman.lib" || { s64_core_lib_module_check && exit 1; }
source "${S64_CORE_PATH_BL64}/bashlib64-core.bash" || { s64_core_lib_check_bl64 && exit 1; }

declare MY_PROFILE="${1:-}"

declare MY_PATH_PROFILE=''

function my_initialize() {
  bl64_dbg_app_show_function
  s64_netman_lib_setup &&
    bl64_check_parameter 'MY_PROFILE' ||
    retirm $?
  MY_PATH_PROFILE="${S64_NETMAN_PATH_ETC_SYSTEM_CONNECTIONS}/${MY_PROFILE}${S64_NETMAN_SUFFIX_PROFILE_FILE}"

  if [[ ! -f "$MY_PATH_PROFILE" ]]; then
    bl64_check_rise_task_failed "Profile file not found (${MY_PROFILE})"
    return $?
  fi

  s64_core_lib_task_show_setup \
    'MY_PROFILE'
}

bl64_lib_script_version_set '1.0.0'
bl64_msg_help_set_about 'Dump profile configuration file'
bl64_msg_help_set_usage 'MY_PROFILE'
s64_core_lib_initialize && my_initialize || exit $?

bl64_msg_show_batch_start "$BL64_SCRIPT_ID"
bl64_txt_dump \
  "$MY_PATH_PROFILE"
bl64_msg_show_batch_finish $? "$BL64_SCRIPT_ID"
