#
# Imports
#

# shellcheck disable=SC2154,SC2015
source "${S64_CORE_PATH_BL64}/bashlib64-module-vcs.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-rxtx.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-api.bash" ||
  { s64_core_lib_check_bl64 && exit 1; }

#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_GITHUB_CMD="${S64_GITHUB_CMD:-}"

  declare S64_GITHUB_SET_LIMIT="${S64_GITHUB_SET_LIMIT:-100}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_GITHUB_VERSION='3.4.0'
  declare S64_GITHUB_ABOUT_MODULE='GitHub CLI'

  declare S64_GITHUB_API_URL='https://api.github.com'
}

#
# External
#

# shellcheck disable=SC2034
{
  export GH_BROWSER
  export GH_DEBUG
  export GH_EDITOR
  export GH_HOST
  export GH_PAGER
  export GH_PATH
  export GH_REPO
  export GH_VERBOSE
}

#
# Functions
#

function s64_github_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_GITHUB_ABOUT_MODULE"
  return 0
}

function s64_github_lib_run_gh() {
  bl64_dbg_app_show_function "$@"
  s64_core_lib_command_require 'S64_GITHUB_CMD' 'gh' ||
    return $?
  _s64_github_lib_harden
  bl64_dbg_app_trace_start
  "$S64_GITHUB_CMD" \
    "$@"
  bl64_dbg_app_trace_stop
}

function _s64_github_lib_harden() {
  bl64_dbg_app_show_function

  bl64_dbg_lib_trace_start
  unset GH_BROWSER
  unset GH_DEBUG
  unset GH_EDITOR
  unset GH_HOST
  unset GH_PATH
  unset GH_REPO
  unset GH_VERBOSE
  bl64_msg_app_detail_is_enabled && GH_VERBOSE='1'
  GH_PAGER="$S64_CORE_SET_PAGER"
  bl64_dbg_app_trace_stop
}
