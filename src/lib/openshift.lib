#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_OPENSHIFT_CMD_CRC="${S64_OPENSHIFT_CMD_CRC:-}"
  declare S64_OPENSHIFT_CMD_OC="${S64_OPENSHIFT_CMD_OC:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_OPENSHIFT_VERSION='1.1.0'
  declare S64_OPENSHIFT_ABOUT_MODULE='OpenShift Container Platform'

  # WARNING: hardcoded path
  declare S64_OPENSHIFT_PATH_CFG_CRC="${HOME}/.crc"
}

#
# Functions
#

function s64_openshift_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_OPENSHIFT_ABOUT_MODULE" &&
    s64_core_lib_command_require 'S64_OPENSHIFT_CMD_CRC' 'crc' &&
    s64_core_lib_command_require 'S64_OPENSHIFT_CMD_OC' 'oc'
}

function s64_openshift_lib_run_crc() {
  bl64_dbg_app_show_function "$@"
  local verbose_flag='--log-level=error'

  bl64_msg_app_detail_is_enabled && verbose_flag='--log-level=info'
  bl64_dbg_app_command_is_enabled && verbose_flag='--log-level=debug'
  bl64_dbg_app_trace_start
  # shellcheck disable=SC2086
  "$S64_OPENSHIFT_CMD_CRC" \
    $verbose_flag \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_openshift_lib_run_oc() {
  bl64_dbg_app_show_function "$@"
  local verbose_flag='--v=1'
  bl64_msg_app_detail_is_enabled || verbose_flag=' '
  bl64_dbg_app_trace_start
  # shellcheck disable=SC2086
  "$S64_OPENSHIFT_CMD_OC" \
    $verbose_flag \
    "$@"
  bl64_dbg_app_trace_stop
}
