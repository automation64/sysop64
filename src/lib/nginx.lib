#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_NGINX_LAB_IMAGE_TAG="${S64_NGINX_LAB_IMAGE_TAG:-latest}"
  declare S64_NGINX_LAB_HOST_NGINX_CONF="${S64_NGINX_LAB_HOST_NGINX_CONF:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_NGINX_VERSION='2.0.0'
  declare S64_NGINX_ABOUT_MODULE='NGINX Web Server'

  declare S64_NGINX_CMD=''
  declare S64_NGINX_PATH_ETC=''
  declare S64_NGINX_PATH_VAR=''
  declare S64_NGINX_PATH_CONFIG=''
  declare S64_NGINX_PATH_LOG_NGINX=''
  declare S64_NGINX_PATH_LOG_ERROR=''
  declare S64_NGINX_PATH_LOG_ACCESS=''

  declare S64_NGINX_SERVICE='X_SERVICE_NAME_X'

  declare S64_NGINX_LAB_IMAGE_NAME='nginx'
  declare S64_NGINX_LAB_CONTAINER_NAME='lab-nginx'
}

#
# Functions
#

function s64_nginx_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_NGINX_ABOUT_MODULE" ||
    return $?

  case "$BL64_OS_FLAVOR" in
    "$BL64_OS_FLAVOR_REDHAT" | "$BL64_OS_FLAVOR_FEDORA")
      S64_NGINX_CMD='/usr/sbin/nginx'
      S64_NGINX_PATH_ETC='/etc/nginx'
      S64_NGINX_PATH_VAR='/var/lib/nginx'
      S64_NGINX_PATH_CONFIG="${S64_NGINX_PATH_ETC}/nginx.conf"
      S64_NGINX_PATH_LOG_NGINX='/var/log/nginx'
      S64_NGINX_PATH_LOG_ERROR="${S64_NGINX_PATH_LOG_NGINX}/error.log"
      S64_NGINX_PATH_LOG_ACCESS="${S64_NGINX_PATH_LOG_NGINX}/access.log"
      S64_NGINX_SERVICE='nginx'
      ;;
    *) bl64_check_rise_task_unsupported ;;
  esac

  s64_core_lib_command_require 'S64_NGINX_CMD' 'nginx'
}

function s64_nginx_lib_run_nginx() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_NGINX_CMD" \
    "$@"
  bl64_dbg_app_trace_stop
}
