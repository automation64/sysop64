#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_SCREEN_CMD="${S64_SCREEN_CMD:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_SCREEN_VERSION='1.1.0'
  declare S64_SCREEN_ABOUT_MODULE='Screen Terminal Multiplexer'
}

#
# Functions
#

function s64_screen_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_SCREEN_ABOUT_MODULE" &&
    s64_core_lib_command_require 'S64_SCREEN_CMD' 'screen'
}

function s64_screen_lib_run_screen() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  # shellcheck disable=SC2086
  "$S64_SCREEN_CMD" \
    $verbose_flag \
    "$@"
  bl64_dbg_app_trace_stop
}
