#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_DNF_VERSION='1.1.0'
  declare S64_DNF_ABOUT_MODULE='DNF - Linux Package Manager'

  declare S64_DNF_CMD_DNF='/usr/bin/dnf'

  declare S64_DNF_PATH_ETC='/etc/dnf'
  declare S64_DNF_PATH_CONF_FILE="${S64_DNF_PATH_ETC}/dnf.conf"
  declare S64_DNF_PATH_CONF_REPOS='/etc/yum.repos.d'
}

#
# Functions
#

function s64_dnf_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_DNF_ABOUT_MODULE" &&
    bl64_os_check_flavor \
      "$BL64_OS_FLAVOR_FEDORA" \
      "$BL64_OS_FLAVOR_REDHAT" &&
    s64_core_lib_command_require 'S64_DNF_CMD_DNF' 'dnf'
}

function s64_dnf_lib_run_dnf() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_DNF_CMD_DNF" \
    "$@"
  bl64_dbg_app_trace_stop
}
