#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_LIBVIRT_CMD="${S64_LIBVIRT_CMD:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_LIBVIRT_VERSION='1.4.0'
  declare S64_LIBVIRT_ABOUT_MODULE='LibVirt Virtual Machine Manager'
  declare S64_LIBVIRT_ABOUT_SUBMODULE_SYS='System'
  declare S64_LIBVIRT_ABOUT_SUBMODULE_QEMU='QEMU'
  declare S64_LIBVIRT_ABOUT_SUBMODULE_LXC='LXC'

  declare S64_LIBVIRT_CMD_VIRSH='/usr/bin/virsh'
  declare S64_LIBVIRT_CMD_VIRTINSTALL='/usr/bin/virt-install'
  declare S64_LIBVIRT_CMD_VIRTMANAGER='/usr/bin/virt-manager'
  declare S64_LIBVIRT_CMD_VIRTVIEWER='/usr/bin/virt-viewer'

  declare S64_LIBVIRT_GROUP_LIBVIRT='libvirt'

  declare S64_LIBVIRT_URI_QEMU_SYSTEM='qemu:///system'
  declare S64_LIBVIRT_URI_LXC_SYSTEM='lxc:///system'

  declare S64_LIBVIRT_SERVICE='libvirtd'
  declare S64_LIBVIRT_SOCKET_LIBVIRTD='libvirtd.socket'
  declare S64_LIBVIRT_SOCKET_LIBVIRTD_RO='libvirtd-ro.socket'
  declare S64_LIBVIRT_SOCKET_LIBVIRTD_ADMIN='libvirtd-admin.socket'
}

#
# Functions
#

function s64_libvirt_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_LIBVIRT_ABOUT_MODULE"
}

function s64_libvirt_lib_run_virsh() {
  bl64_dbg_app_show_function "$@"
  bl64_check_command "$S64_LIBVIRT_CMD_VIRSH" "$BL64_VAR_DEFAULT" 'S64_LIBVIRT_CMD_VIRSH' ||
    return $?
  bl64_dbg_app_trace_start
  "$S64_LIBVIRT_CMD_VIRSH" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_libvirt_lib_run_virtinstall() {
  bl64_dbg_app_show_function "$@"
  bl64_check_command "$S64_LIBVIRT_CMD_VIRTINSTALL" "$BL64_VAR_DEFAULT" 'S64_LIBVIRT_CMD_VIRTINSTALL' ||
    return $?
  bl64_dbg_app_trace_start
  "$S64_LIBVIRT_CMD_VIRTINSTALL" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_libvirt_lib_run_virtviewer() {
  bl64_dbg_app_show_function "$@"
  bl64_check_command "$S64_LIBVIRT_CMD_VIRTVIEWER" "$BL64_VAR_DEFAULT" 'S64_LIBVIRT_CMD_VIRTVIEWER' ||
    return $?
  bl64_dbg_app_trace_start
  "$S64_LIBVIRT_CMD_VIRTVIEWER" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_libvirt_lib_run_virtmanager() {
  bl64_dbg_app_show_function "$@"
  bl64_check_command "$S64_LIBVIRT_CMD_VIRTMANAGER" "$BL64_VAR_DEFAULT" 'S64_LIBVIRT_CMD_VIRTMANAGER' ||
    return $?
  bl64_dbg_app_trace_start
  "$S64_LIBVIRT_CMD_VIRTMANAGER" \
    "$@"
  bl64_dbg_app_trace_stop
}
