#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_NETMAN_CFG_OUTPUT_MODE="${S64_NETMAN_CFG_OUTPUT_MODE:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_NETMAN_VERSION='1.0.1'
  declare S64_NETMAN_ABOUT_MODULE='Linux Network Manager'

  # SystemD service name
  declare S64_NETMAN_SERVICE_NAME='NetworkManager'

  declare S64_NETMAN_CMD_NMCLI='/usr/bin/nmcli'
  declare S64_NETMAN_CMD_NETMAN='/usr/sbin/NetworkManager'
}

#
# Functions
#

function s64_netman_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_NETMAN_ABOUT_MODULE" &&
    bl64_check_command "$S64_NETMAN_CMD_NMCLI" "$BL64_VAR_DEFAULT" 'S64_NETMAN_CMD_NMCLI' &&
    bl64_check_command "$S64_NETMAN_CMD_NETMAN" "$BL64_VAR_DEFAULT" 'S64_NETMAN_CMD_NETMAN'
}

function s64_netman_lib_run_nmcli() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_NETMAN_CMD_NMCLI" \
    ${S64_NETMAN_CFG_OUTPUT_MODE:+--mode "$S64_NETMAN_CFG_OUTPUT_MODE"} \
    --pretty \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_netman_lib_run_netman() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_NETMAN_CMD_NETMAN" \
    "$@"
  bl64_dbg_app_trace_stop
}
