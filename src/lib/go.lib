#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_GO_CMD_GO="${S64_GO_CMD_GO:-}"
  declare S64_GO_CMD_GOFMT="${S64_GO_CMD_GOFMT:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_GO_VERSION='1.1.0'
  declare S64_GO_ABOUT_MODULE='Go Programming Language'
}

#
# Functions
#

function s64_go_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_GO_ABOUT_MODULE" &&
    s64_core_lib_command_require 'S64_GO_CMD_GO' 'go' &&
    s64_core_lib_command_require 'S64_GO_CMD_GOFMT' 'gofmt'
}

function s64_go_lib_run_go() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_GO_CMD_GO" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_go_lib_run_gofmt() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_GO_CMD_GOFMT" \
    "$@"
  bl64_dbg_app_trace_stop
}
