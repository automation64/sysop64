#
# Imports
#

# shellcheck disable=SC2154,SC2015
source "${S64_CORE_PATH_BL64}/bashlib64-module-cnt.bash" ||
  { s64_core_lib_check_bl64 && exit 1; }

#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_PODMAN_REGISTRY_HOST="${S64_PODMAN_REGISTRY_HOST:-}"
  declare S64_PODMAN_REGISTRY_PORT="${S64_PODMAN_REGISTRY_PORT:-}"
  declare S64_PODMAN_REGISTRY_SERVER="${S64_PODMAN_REGISTRY_SERVER:-}"
  declare S64_PODMAN_REGISTRY_USE_TLS="${S64_PODMAN_REGISTRY_USE_TLS:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_PODMAN_VERSION='1.0.0'
  declare S64_PODMAN_ABOUT_MODULE='PodMan - Container Management Tool'
}

#
# Functions
#

function s64_podman_lib_setup() {
  bl64_dbg_app_show_function
  S64_PODMAN_REGISTRY_SERVER="${S64_PODMAN_REGISTRY_HOST}${S64_PODMAN_REGISTRY_PORT:+:${S64_PODMAN_REGISTRY_PORT}}"
  s64_core_lib_module_show_about "$S64_PODMAN_ABOUT_MODULE" &&
    bl64_cnt_setup &&
    bl64_check_command "$BL64_CNT_CMD_PODMAN" "$BL64_VAR_DEFAULT" 'podman' &&
    s64_core_lib_module_show_setup \
      'S64_PODMAN_REGISTRY_HOST' \
      'S64_PODMAN_REGISTRY_PORT' \
      'S64_PODMAN_REGISTRY_SERVER' \
      'S64_PODMAN_REGISTRY_USE_TLS'
}

function s64_podman_lib_cli_set_insecure() {
  bl64_dbg_app_show_function
  if ! bl64_lib_flag_is_enabled "$S64_PODMAN_REGISTRY_USE_TLS"; then
    printf -- '--tls-verify=false'
  else
    printf -- '--tls-verify=true'
  fi
}
