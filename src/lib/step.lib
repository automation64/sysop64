#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_STEP_CMD="${S64_STEP_CMD:-}"

  declare S64_STEP_PATH_HOME="${S64_STEP_PATH_HOME:-$HOME/.step}"

  declare S64_STEP_SET_CA_PORT="${S64_STEP_SET_CA_PORT:-443}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_STEP_VERSION='1.0.0'
  declare S64_STEP_ABOUT_MODULE='Step - Online certificate authority server'
}

#
# External
#

# shellcheck disable=SC2034
{
  export STEPPATH
  export STEPDEBUG
}

#
# Functions
#

function s64_step_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_STEP_ABOUT_MODULE" &&
    s64_core_lib_command_require 'S64_STEP_CMD' 'step'
}

function s64_step_lib_run_step() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_command_is_enabled || STEPDEBUG='1'
  STEPPATH="$S64_STEP_PATH_HOME"
  bl64_dbg_app_trace_start
  "$S64_STEP_CMD" \
    "$@"
  bl64_dbg_app_trace_stop
}
