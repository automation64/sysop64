#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_SONOBUOY_CMD="${S64_SONOBUOY_CMD:-}"

  declare S64_SONOBUOY_PATH_E2E_REPO_CONFIG="${S64_SONOBUOY_PATH_E2E_REPO_CONFIG:-}"

  declare S64_SONOBUOY_CFG_KUBERNETES_VERSION="${S64_SONOBUOY_CFG_KUBERNETES_VERSION:-}"

  declare S64_SONOBUOY_IMAGE_SONOBUOY="${S64_SONOBUOY_IMAGE_SONOBUOY:-}"
  declare S64_SONOBUOY_IMAGE_KUBE_CONFORMANCE="${S64_SONOBUOY_IMAGE_KUBE_CONFORMANCE:-}"
  declare S64_SONOBUOY_IMAGE_SYSTEMD_LOGS="${S64_SONOBUOY_IMAGE_SYSTEMD_LOGS:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_SONOBUOY_VERSION='1.0.0'
  declare S64_SONOBUOY_ABOUT_MODULE='Sonobuoy - Kubernetes Test Framework'

}

#
# Functions
#

function s64_sonobuoy_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_SONOBUOY_ABOUT_MODULE" &&
    s64_core_lib_command_require 'S64_SONOBUOY_CMD' 'sonobuoy' &&
    s64_core_lib_module_show_setup \
      'S64_SONOBUOY_CFG_KUBERNETES_VERSION' \
      'S64_SONOBUOY_PATH_E2E_REPO_CONFIG' \
      'S64_SONOBUOY_IMAGE_SONOBUOY' \
      'S64_SONOBUOY_IMAGE_SYSTEMD_LOGS' \
      'S64_SONOBUOY_IMAGE_KUBE_CONFORMANCE'
}

function s64_sonobuoy_lib_run_sonobuoy() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_SONOBUOY_CMD" \
    "$@"
  bl64_dbg_app_trace_stop
}
