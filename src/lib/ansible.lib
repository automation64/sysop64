#
# Imports
#

# shellcheck disable=SC2154,SC2015
source "${S64_CORE_PATH_BL64}/bashlib64-module-py.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-ans.bash" ||
  { s64_core_lib_check_bl64 && exit 1; }

#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_ANSIBLE_PATH_BIN="${S64_ANSIBLE_PATH_BIN:-$BL64_VAR_DEFAULT}"

  declare S64_ANSIBLE_PATH_INVENTORY="${S64_ANSIBLE_PATH_INVENTORY:-}"
  declare S64_ANSIBLE_PATH_CONFIG="${S64_ANSIBLE_PATH_CONFIG:-$BL64_VAR_DEFAULT}"

  declare S64_ANSIBLE_SET_OUTPUT_PLUGIN="${S64_ANSIBLE_SET_OUTPUT_PLUGIN:-default}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_ANSIBLE_VERSION='2.0.0'
  declare S64_ANSIBLE_ABOUT_MODULE='Ansible Platform'
  declare S64_ANSIBLE_CMD_CONFIG=''
  declare S64_ANSIBLE_CMD_DOC=''
  declare S64_ANSIBLE_CMD_INVENTORY=''
}

#
# Functions
#

function s64_ansible_lib_setup() {
  bl64_dbg_app_show_function

  s64_core_lib_module_show_about "$S64_ANSIBLE_ABOUT_MODULE"
  bl64_ans_setup "$S64_ANSIBLE_PATH_BIN" "$S64_ANSIBLE_PATH_CONFIG" &&
    bl64_ans_set_paths "$S64_ANSIBLE_PATH_CONFIG" "$BL64_VAR_DEFAULT" "$BL64_VAR_DEFAULT" "$BL64_VAR_DEFAULT" "$S64_ANSIBLE_PATH_INVENTORY" &&
    bl64_ans_set_options "$S64_ANSIBLE_SET_OUTPUT_PLUGIN" &&
    s64_core_lib_command_require 'S64_ANSIBLE_CMD_CONFIG' 'ansible-config' "$S64_ANSIBLE_PATH_BIN" &&
    s64_core_lib_command_require 'S64_ANSIBLE_CMD_DOC' 'ansible-doc' "$S64_ANSIBLE_PATH_BIN" &&
    s64_core_lib_command_require 'S64_ANSIBLE_CMD_INVENTORY' 'ansible-inventory' "$S64_ANSIBLE_PATH_BIN" &&
    s64_core_lib_module_show_setup \
      'S64_ANSIBLE_PATH_INVENTORY' \
      'S64_ANSIBLE_PATH_CONFIG'
}

function s64_ansible_lib_run_doc() {
  bl64_dbg_app_show_function "$@"
  bl64_ans_harden_ansible
  bl64_dbg_app_trace_start
  # shellcheck disable=SC2086
  "$S64_ANSIBLE_CMD_DOC" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_ansible_lib_run_inventory() {
  bl64_dbg_app_show_function "$@"
  bl64_ans_harden_ansible
  bl64_dbg_app_trace_start
  # shellcheck disable=SC2086
  "$S64_ANSIBLE_CMD_INVENTORY" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_ansible_lib_run_config() {
  bl64_dbg_app_show_function "$@"
  bl64_ans_harden_ansible
  bl64_dbg_app_trace_start
  # shellcheck disable=SC2086
  "$S64_ANSIBLE_CMD_CONFIG" \
    "$@"
  bl64_dbg_app_trace_stop
}
