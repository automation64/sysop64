#
# Imports
#

# shellcheck disable=SC2154,SC2015
source "${S64_CORE_PATH_BL64}/bashlib64-module-bsh.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-fmt.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-xsv.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-txt.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-fs.bash" ||
  { s64_core_lib_check_bl64 && exit 1; }

#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_PROTON_PATH_CLI_PROTONVPN='/usr/bin/protonvpn'
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_PROTON_VERSION='1.0.0'
  declare S64_PROTON_ABOUT_MODULE_MAIN='Proton Tools'
}

#
# Functions
#

function s64_proton_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_PROTON_ABOUT_MODULE_MAIN"
}

function s64_proton_lib_run_protonvpn() {
  bl64_dbg_app_show_function "$@"
  bl64_check_command "$S64_PROTON_PATH_CLI_PROTONVPN" "$BL64_VAR_DEFAULT" 'S64_PROTON_PATH_CLI_PROTONVPN' ||
    return $?
  bl64_dbg_app_trace_start
  "$S64_PROTON_PATH_CLI_PROTONVPN" \
    "$@"
  bl64_dbg_app_trace_stop
}
