#
# Imports
#

# shellcheck disable=SC2154,SC2015
source "${S64_CORE_PATH_BL64}/bashlib64-module-k8s.bash" ||
  { s64_core_lib_check_bl64 && exit 1; }

#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_K8S_CMD_KUBEADM="${S64_K8S_CMD_KUBEADM:-}"

  # KubeCTL Options
  declare S64_K8S_CFG_KUBECTL_FORMAT="${S64_K8S_CFG_KUBECTL_FORMAT:-yaml}"
  declare S64_K8S_PATH_ETC_KUBECTL="${S64_K8S_PATH_ETC_KUBECTL:-${HOME}/.kube}"
  declare S64_K8S_PATH_CFG_KUBECONFIG="${S64_K8S_PATH_CFG_KUBECONFIG:-${S64_K8S_PATH_ETC_KUBECTL}/config}"

  # Control Plane API
  declare S64_K8S_CFG_API_VHOST="${S64_K8S_CFG_API_VHOST:-}"
  declare S64_K8S_CFG_API_PORT="${S64_K8S_CFG_API_PORT:-6443}"
  declare S64_K8S_CFG_API_ENDPOINT="${S64_K8S_CFG_API_ENDPOINT:-}"

  # Cluster Join Credentials
  declare S64_K8S_CFG_JOIN_TOKEN="${S64_K8S_CFG_JOIN_TOKEN:-}"
  declare S64_K8S_CFG_JOIN_HASH="${S64_K8S_CFG_JOIN_HASH:-}"

  # KubeADM Global configuration file name
  declare S64_K8S_FILE_KUBEADM_CONF="${S64_K8S_FILE_KUBEADM_CONF:-kubeadm.yaml}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_K8S_VERSION='4.6.0'
  declare S64_K8S_ABOUT_MODULE='Kubernetes Platform'
  declare S64_K8S_ABOUT_SUBMODULE_API='API'
  declare S64_K8S_ABOUT_SUBMODULE_CLI='KubeCTL'
  declare S64_K8S_ABOUT_SUBMODULE_CP='Control Plane'
  declare S64_K8S_ABOUT_SUBMODULE_DS='DaemonSet'
  declare S64_K8S_ABOUT_SUBMODULE_EVENT='Events'
  declare S64_K8S_ABOUT_SUBMODULE_NET='Network'
  declare S64_K8S_ABOUT_SUBMODULE_NODE='Nodes'
  declare S64_K8S_ABOUT_SUBMODULE_OBJ='Objects'
  declare S64_K8S_ABOUT_SUBMODULE_SECRET='Secrets'
  declare S64_K8S_ABOUT_SUBMODULE_WKL='Workloads'

  # OS System Service name
  declare S64_K8S_SERVICE_KUBELET='kubelet'

  declare S64_K8S_PATH_ETC_CLUSTER='/etc/kubernetes'
  declare S64_K8S_PATH_ETC_CNI='/etc/cni'
  declare S64_K8S_PATH_VAR_CNI='/var/lib/cni'
  declare S64_K8S_PATH_VAR_ETCD='/var/lib/etcd'
  declare S64_K8S_PATH_VAR_KUBELET='/var/lib/kubelet'

  declare S64_K8S_PATH_CFG_ADMINCONF="${S64_K8S_PATH_ETC_CLUSTER}/admin.conf"
  declare S64_K8S_PATH_CFG_KUBEADM="${S64_K8S_PATH_ETC_CLUSTER}/${S64_K8S_FILE_KUBEADM_CONF}"
  declare S64_K8S_PATH_CFG_KUBELET="${S64_K8S_PATH_VAR_KUBELET}/config.yaml"

  declare S64_K8S_PATH_KEY_CA="${S64_K8S_PATH_ETC_CLUSTER}/pki/ca.crt"

  declare S64_K8S_TAG_NAMESPACE_ALL='ALL'
  declare S64_K8S_TAG_NAMESPACE_DEFAULT='default'
}

#
# Functions
#

function s64_k8s_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_K8S_ABOUT_MODULE"
  if ! bl64_lib_var_is_set "$S64_K8S_CFG_API_ENDPOINT" && bl64_lib_var_is_set "$S64_K8S_CFG_API_VHOST"; then
    S64_K8S_CFG_API_ENDPOINT="${S64_K8S_CFG_API_VHOST}:${S64_K8S_CFG_API_PORT}"
  fi
  s64_core_lib_command_assign 'S64_K8S_CMD_KUBEADM' 'kubeadm'
  bl64_k8s_setup || return $?
  [[ -f "$S64_K8S_PATH_CFG_KUBECONFIG" ]] && bl64_k8s_set_kubeconfig "$S64_K8S_PATH_CFG_KUBECONFIG"

  s64_core_lib_module_show_setup \
    'S64_K8S_CFG_API_ENDPOINT' \
    'S64_K8S_PATH_CFG_KUBECONFIG'
}

function s64_k8s_lib_setup_secondary() {
  bl64_dbg_app_show_function
  bl64_dbg_app_show_comments 'use this function instead of s64_k8s_lib_setup when not the primary module'
  S64_CORE_SET_MODULE_PRIMARY='NO' s64_k8s_lib_setup
}

function s64_k8s_lib_cli_set_ns() {
  bl64_dbg_app_show_function "$@"
  local namespace="${1:-$BL64_VAR_DEFAULT}"
  # shellcheck disable=SC2154,SC2015
  if [[ "$namespace" == "$BL64_VAR_DEFAULT" || "$namespace" == "$S64_K8S_TAG_NAMESPACE_ALL" ]]; then
    printf -- '--all-namespaces'
  else
    printf -- '--namespace=%s' "${namespace}"
  fi
}

function s64_k8s_lib_meta_strip_runtime() {
  bl64_dbg_app_show_function
  bl64_txt_run_awk '
    /^[ ]+creationTimestamp:/ { next }
    $0 == "status: {}" { next }
    { print $0 }
  '
}

function s64_k8s_lib_cli_set_format() {
  bl64_dbg_app_show_function "$@"
  local format="${1:-}"
  if [[ "$format" != 'yaml' ]]; then
    S64_K8S_CFG_KUBECTL_FORMAT="$format"
  fi
  printf -- '--output=%s' "${S64_K8S_CFG_KUBECTL_FORMAT}"
}

function s64_k8s_lib_run_kubeadm() {
  bl64_dbg_app_show_function "$@"
  local debug_flag='--v 2'
  bl64_dbg_app_command_is_enabled || debug_flag=' '
  bl64_check_command "$S64_K8S_CMD_KUBEADM" "$BL64_VAR_DEFAULT" 'S64_K8S_CMD_KUBEADM' ||
    return $?
  bl64_dbg_app_trace_start
  # shellcheck disable=SC2086
  "$S64_K8S_CMD_KUBEADM" \
    $debug_flag \
    "$@"
  bl64_dbg_app_trace_stop
}
