function s64_unix_lib_run_shutdown() {
  bl64_dbg_app_show_function "$@"
  bl64_check_command "$S64_UNIX_CMD_SHUTDOWN" "$BL64_VAR_DEFAULT" 'S64_UNIX_CMD_SHUTDOWN' || return $?
