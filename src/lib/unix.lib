#
# Imports
#

# shellcheck disable=SC2154,SC2015
source "${S64_CORE_PATH_BL64}/bashlib64-module-bsh.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-fmt.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-xsv.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-txt.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-fs.bash" ||
  { s64_core_lib_check_bl64 && exit 1; }

#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_UNIX_SET_PING_COUNT="${S64_UNIX_SET_PING_COUNT:-5}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_UNIX_VERSION='2.5.0'
  declare S64_UNIX_ABOUT_MODULE='Unix OS'
  declare S64_UNIX_ABOUT_SUBMODULE_BKP='Backup and Archive'
  declare S64_UNIX_ABOUT_SUBMODULE_FS='File System'
  declare S64_UNIX_ABOUT_SUBMODULE_NET='Networking'
  declare S64_UNIX_ABOUT_SUBMODULE_SVC='Services'
  declare S64_UNIX_ABOUT_SUBMODULE_SYS='System'

  declare S64_UNIX_CMD_DF=''
  declare S64_UNIX_CMD_DD=''
  declare S64_UNIX_CMD_DU=''
  declare S64_UNIX_CMD_KILL=''
  declare S64_UNIX_CMD_LS=''
  declare S64_UNIX_CMD_MOUNT=''
  declare S64_UNIX_CMD_NETSTAT=''
  declare S64_UNIX_CMD_NSLOOKUP=''
  declare S64_UNIX_CMD_PING=''
  declare S64_UNIX_CMD_PS=''
  declare S64_UNIX_CMD_SHUTDOWN=''
  declare S64_UNIX_CMD_SU=''
  declare S64_UNIX_CMD_UMOUNT=''
}

#
# Functions
#

function s64_unix_lib_setup() {
  bl64_dbg_app_show_function
  # shellcheck disable=SC2154,SC2015,SC2034
  s64_core_lib_module_show_about "$S64_UNIX_ABOUT_MODULE" &&
    case "$BL64_OS_FLAVOR" in
      "$BL64_OS_FLAVOR_ALPINE")
        S64_UNIX_CMD_DF='/bin/df'
        S64_UNIX_CMD_DD='/usr/bin/dd'
        S64_UNIX_CMD_DU='/usr/bin/du'
        S64_UNIX_CMD_KILL='/bin/kill'
        S64_UNIX_CMD_LS='/bin/ls'
        S64_UNIX_CMD_MOUNT='/bin/mount'
        S64_UNIX_CMD_NETSTAT='/bin/netstat'
        S64_UNIX_CMD_NSLOOKUP='/usr/bin/nslookup'
        S64_UNIX_CMD_PING='/bin/ping'
        S64_UNIX_CMD_PS='/bin/ps'
        S64_UNIX_CMD_SHUTDOWN='/sbin/shutdown'
        S64_UNIX_CMD_SU='/bin/su'
        S64_UNIX_CMD_UMOUNT='/bin/umount'
        ;;
      "$BL64_OS_FLAVOR_DEBIAN" | "$BL64_OS_FLAVOR_SUSE")
        S64_UNIX_CMD_DF='/bin/df'
        S64_UNIX_CMD_DD='/usr/bin/dd'
        S64_UNIX_CMD_DU='/usr/bin/du'
        S64_UNIX_CMD_KILL='/bin/kill'
        S64_UNIX_CMD_LS='/bin/ls'
        S64_UNIX_CMD_MOUNT='/bin/mount'
        S64_UNIX_CMD_NETSTAT='/bin/netstat'
        S64_UNIX_CMD_NSLOOKUP='/usr/bin/nslookup'
        S64_UNIX_CMD_PING='/bin/ping'
        S64_UNIX_CMD_PS='/bin/ps'
        S64_UNIX_CMD_SHUTDOWN='/sbin/shutdown'
        S64_UNIX_CMD_SU='/bin/su'
        S64_UNIX_CMD_UMOUNT='/bin/umount'
        ;;
      "$BL64_OS_FLAVOR_ARCH")
        S64_UNIX_CMD_DF='/usr/bin/df'
        S64_UNIX_CMD_DD='/usr/bin/dd'
        S64_UNIX_CMD_DU='/usr/bin/du'
        S64_UNIX_CMD_KILL='/usr/bin/kill'
        S64_UNIX_CMD_LS='/usr/bin/ls'
        S64_UNIX_CMD_MOUNT='/usr/bin/mount'
        S64_UNIX_CMD_NETSTAT='/bin/netstat'
        S64_UNIX_CMD_NSLOOKUP='/usr/bin/nslookup'
        S64_UNIX_CMD_PING='/usr/bin/ping'
        S64_UNIX_CMD_PS='/usr/bin/ps'
        S64_UNIX_CMD_SHUTDOWN='/usr/sbin/shutdown'
        S64_UNIX_CMD_SU='/usr/bin/su'
        S64_UNIX_CMD_UMOUNT='/usr/bin/umount'
        ;;
      "$BL64_OS_FLAVOR_FEDORA" | "$BL64_OS_FLAVOR_REDHAT")
        S64_UNIX_CMD_DF='/usr/bin/df'
        S64_UNIX_CMD_DD='/usr/bin/dd'
        S64_UNIX_CMD_DU='/usr/bin/du'
        S64_UNIX_CMD_KILL='/usr/bin/kill'
        S64_UNIX_CMD_LS='/usr/bin/ls'
        S64_UNIX_CMD_MOUNT='/usr/bin/mount'
        S64_UNIX_CMD_NETSTAT='/bin/netstat'
        S64_UNIX_CMD_NSLOOKUP='/usr/bin/nslookup'
        S64_UNIX_CMD_PING='/usr/bin/ping'
        S64_UNIX_CMD_PS='/bin/ps'
        S64_UNIX_CMD_SHUTDOWN='/usr/sbin/shutdown'
        S64_UNIX_CMD_SU='/usr/bin/su'
        S64_UNIX_CMD_UMOUNT='/usr/bin/umount'
        ;;
      "$BL64_OS_FLAVOR_MACOS")
        S64_UNIX_CMD_DF='/bin/df'
        S64_UNIX_CMD_DD='/usr/bin/dd'
        S64_UNIX_CMD_DU='/usr/bin/du'
        S64_UNIX_CMD_KILL='/bin/kill'
        S64_UNIX_CMD_LS='/bin/ls'
        S64_UNIX_CMD_MOUNT='/sbin/mount'
        S64_UNIX_CMD_NETSTAT='/usr/sbin/netstat'
        S64_UNIX_CMD_NSLOOKUP='/usr/bin/nslookup'
        S64_UNIX_CMD_PING='/sbin/ping'
        S64_UNIX_CMD_PS='/bin/ps'
        S64_UNIX_CMD_SHUTDOWN='/usr/sbin/shutdown'
        S64_UNIX_CMD_SU='/usr/bin/su'
        S64_UNIX_CMD_UMOUNT='/sbin/umount'
        ;;
      *)
        bl64_check_rise_task_unsupported
        ;;
    esac
}

function s64_unix_lib_run_ps() {
  bl64_dbg_app_show_function "$@"
  bl64_check_command "$S64_UNIX_CMD_PS" "$BL64_VAR_DEFAULT" 'S64_UNIX_CMD_PS' || return $?
  bl64_dbg_app_trace_start
  "$S64_UNIX_CMD_PS" \
    "$@"
  bl64_dbg_app_trace_stop
}

