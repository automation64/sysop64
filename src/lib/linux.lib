      S64_LINUX_CMD_MODINFO='/usr/bin/modinfo'
      S64_LINUX_CMD_MODPROBE='/usr/bin/modprobe'
      S64_LINUX_CMD_MOUNT='/usr/bin/mount'
      S64_LINUX_CMD_NFT='/usr/sbin/nft'
      S64_LINUX_CMD_PACMAN_CONF="$BL64_VAR_INCOMPATIBLE"
      S64_LINUX_CMD_PACMAN_KEY="$BL64_VAR_INCOMPATIBLE"
      S64_LINUX_CMD_PARTED='/usr/sbin/parted'
      S64_LINUX_CMD_PVS='/usr/sbin/pvs'
      S64_LINUX_CMD_RCSERVICE="$BL64_VAR_INCOMPATIBLE"
      S64_LINUX_CMD_RCSTATUS="$BL64_VAR_INCOMPATIBLE"
      S64_LINUX_CMD_SMARTCTL='/usr/sbin/smartctl'
      S64_LINUX_CMD_SS='/usr/bin/ss'
      S64_LINUX_CMD_STAT='/usr/bin/stat'
      S64_LINUX_CMD_SWAPOFF='/usr/bin/swapoff'
      S64_LINUX_CMD_SWAPON='/usr/bin/swapon'
      S64_LINUX_CMD_SYSCTL='/usr/sbin/sysctl'
      S64_LINUX_CMD_TCPDUMP='/usr/sbin/tcpdump'
      S64_LINUX_CMD_TRACEPATH='/usr/bin/tracepath'
      S64_LINUX_CMD_UDEVADM='/usr/bin/udevadm'
      S64_LINUX_CMD_UDISKSCTL='/usr/bin/udisksctl'
      S64_LINUX_CMD_UPDATE_ALTERNATIVES="$BL64_VAR_INCOMPATIBLE"
      S64_LINUX_CMD_VGS='/usr/sbin/vgs'

      S64_LINUX_PATH_GRUB_CONFIG='/boot/grub2/grub.cfg'
      S64_LINUX_PATH_GRUB_OPTIONS='/etc/default/grub'
      ;;
    *)
      bl64_check_rise_task_unsupported
      return $?
      ;;
  esac
}

