#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_SKOPEO_CMD="${S64_SKOPEO_CMD:-}"
  declare S64_SKOPEO_REGISTRY_HOST="${S64_SKOPEO_REGISTRY_HOST:-}"
  declare S64_SKOPEO_REGISTRY_PORT="${S64_SKOPEO_REGISTRY_PORT:-}"
  declare S64_SKOPEO_REGISTRY_SERVER="${S64_SKOPEO_REGISTRY_SERVER:-}"
  declare S64_SKOPEO_REGISTRY_USE_TLS="${S64_SKOPEO_REGISTRY_USE_TLS:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_SKOPEO_VERSION='1.0.0'
  declare S64_SKOPEO_ABOUT_MODULE='Skopeo - Container Registry Management'

}

#
# Functions
#

function s64_skopeo_lib_setup() {
  bl64_dbg_app_show_function
  S64_SKOPEO_REGISTRY_SERVER="${S64_SKOPEO_REGISTRY_HOST}${S64_SKOPEO_REGISTRY_PORT:+:${S64_SKOPEO_REGISTRY_PORT}}"
  s64_core_lib_module_show_about "$S64_SKOPEO_ABOUT_MODULE" &&
    s64_core_lib_command_require 'S64_SKOPEO_CMD' 'skopeo' &&
    s64_core_lib_module_show_setup \
      'S64_SKOPEO_REGISTRY_HOST' \
      'S64_SKOPEO_REGISTRY_PORT' \
      'S64_SKOPEO_REGISTRY_SERVER' \
      'S64_SKOPEO_REGISTRY_USE_TLS'
}

function s64_skopeo_lib_run_skopeo() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_SKOPEO_CMD" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_skopeo_lib_cli_set_insecure() {
  bl64_dbg_app_show_function
  if ! bl64_lib_flag_is_enabled "$S64_SKOPEO_REGISTRY_USE_TLS"; then
    printf -- '--tls-verify=false'
  else
    printf -- '--tls-verify=true'
  fi
}
