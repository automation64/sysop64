#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_SQUID_VERSION='1.0.0'
  declare S64_SQUID_ABOUT_MODULE='Squid - Web Proxy'

  declare S64_SQUID_PATH_ETC='/etc/squid'
  declare S64_SQUID_PATH_LOG='/var/log/squid'
  declare S64_SQUID_PATH_SQUID_CONF="${S64_SQUID_PATH_ETC}/squid.conf"
  declare S64_SQUID_PATH_ACCESS_LOG="${S64_SQUID_PATH_LOG}/access.log"
  declare S64_SQUID_PATH_CACHE_LOG="${S64_SQUID_PATH_LOG}/cache.log"
  declare S64_SQUID_SERVICE='squid'
}

#
# Functions
#

function s64_squid_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_SQUID_ABOUT_MODULE"
}
