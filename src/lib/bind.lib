#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_BIND_VERSION='1.2.0'
  declare S64_BIND_ABOUT_MODULE='BIND - DNS Server'

  declare S64_BIND_SERVICE=''

  declare S64_BIND_PATH_ETC=''
  declare S64_BIND_PATH_VAR=''
  declare S64_BIND_PATH_LOG=''
  declare S64_BIND_PATH_NAMED_CONF=''
  declare S64_BIND_PATH_NAMED_LOG=''

  declare S64_BIND_PREFIX_NAMED_CONF='named.'
  declare S64_BIND_SUFFIX_NAMED_CONF='.zones'
  declare S64_BIND_SUFFIX_NAMED_DB='.db'

  declare S64_BIND_CMD_MDIG=''
  declare S64_BIND_CMD_NAMED_CHECKCONF=''
  declare S64_BIND_CMD_NAMED_CHECKZONE=''
  declare S64_BIND_CMD_RNDC=''
}

#
# Functions
#

function s64_bind_lib_setup() {
  bl64_dbg_app_show_function
  s64_core_lib_module_show_about "$S64_BIND_ABOUT_MODULE" ||
    return $?

  case "$BL64_OS_FLAVOR" in
    "$BL64_OS_FLAVOR_REDHAT" | "$BL64_OS_FLAVOR_FEDORA")
      S64_BIND_PATH_ETC='/etc'
      S64_BIND_PATH_VAR='/var/named'
      S64_BIND_PATH_ETC_NAMED='/etc/named'
      S64_BIND_PATH_NAMED_CONF='/etc/named.conf'
      S64_BIND_SERVICE='named'

      S64_BIND_CMD_MDIG='/usr/bin/mdig'
      S64_BIND_CMD_NAMED_CHECKCONF='/usr/bin/named-checkconf'
      S64_BIND_CMD_NAMED_CHECKZONE='/usr/bin/named-checkzone'
      ;;
    *) bl64_check_rise_task_unsupported ;;
  esac

  s64_core_lib_command_require 'S64_BIND_CMD_MDIG' 'mdig' &&
    s64_core_lib_command_require 'S64_BIND_CMD_NAMED_CHECKCONF' 'named-checkconf' &&
    s64_core_lib_command_require 'S64_BIND_CMD_NAMED_CHECKZONE' 'named-checkzone' &&
    s64_core_lib_command_require 'S64_BIND_CMD_RNDC' 'rndc'
}

function s64_bind_lib_run_mdig() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_BIND_CMD_MDIG" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_bind_lib_run_named_checkconf() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_BIND_CMD_NAMED_CHECKCONF" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_bind_lib_run_named_checkzone() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_BIND_CMD_NAMED_CHECKZONE" \
    "$@"
  bl64_dbg_app_trace_stop
}

function s64_bind_lib_run_rndc() {
  bl64_dbg_app_show_function "$@"
  bl64_dbg_app_trace_start
  "$S64_BIND_CMD_RNDC" \
    "$@"
  bl64_dbg_app_trace_stop
}
