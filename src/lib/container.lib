#
# Imports
#

# shellcheck disable=SC2154,SC2015
source "${S64_CORE_PATH_BL64}/bashlib64-module-vcs.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-rxtx.bash" &&
  source "${S64_CORE_PATH_BL64}/bashlib64-module-api.bash" ||
  { s64_core_lib_check_bl64 && exit 1; }

#
# Module parameters
#

# shellcheck disable=SC2034
{
  declare S64_CONTAINER_REGISTRY_HOST="${S64_CONTAINER_REGISTRY_HOST:-}"
  declare S64_CONTAINER_REGISTRY_PORT="${S64_CONTAINER_REGISTRY_PORT:-}"
  declare S64_CONTAINER_REGISTRY_SERVER="${S64_CONTAINER_REGISTRY_SERVER:-}"
}

#
# Globals
#

# shellcheck disable=SC2034
{
  declare S64_CONTAINER_VERSION='1.1.0'
  declare S64_CONTAINER_ABOUT_MODULE='Container - Open Container Initiative Tools'

}

#
# Functions
#

function s64_container_lib_setup() {
  bl64_dbg_app_show_function
  if ! bl64_lib_var_is_set "$S64_CONTAINER_REGISTRY_SERVER"; then
    S64_CONTAINER_REGISTRY_SERVER="${S64_CONTAINER_REGISTRY_HOST:-localhost}:${S64_CONTAINER_REGISTRY_PORT:-5000}"
  fi
  s64_core_lib_module_show_about "$S64_CONTAINER_ABOUT_MODULE"
  s64_core_lib_module_show_setup \
    'S64_CONTAINER_REGISTRY_HOST' \
    'S64_CONTAINER_REGISTRY_PORT' \
    'S64_CONTAINER_REGISTRY_SERVER'
}
